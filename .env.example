DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=https://gw2.vaultinc.fr/auth/callback
# Leave empty to allow any Discord account to log in; set to restrict to one guild's members.
DISCORD_GUILD_ID=

# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

DB_PATH=/data/gw2-ops-board.db
REFRESH_INTERVAL_MINUTES=30
FLIP_SCAN_INTERVAL_MINUTES=60
